default-timeout=10000
group-by=summary
layer=top
anchor=top-right

width=200
height=200
margin=20,20,0
padding=12,14,12
max-icon-size=88
icon-location=right

background-color={{colors.background.default.hex}}
text-color={{colors.primary.default.hex}}
border-color={{colors.primary.default.hex}}
border-size=2
border-radius=10

markup=1
format=<span font="CaskaydiaCove Nerd Font Mono" size="11000" weight="bold">%s</span>\n<span font="CaskaydiaCove Nerd Font" size="10000">%b</span>

[grouped]
format=<span font="CaskaydiaCove Nerd Font Mono Italic" size="11000">%s</span>\n<span font="CaskaydiaCove Nerd Font" size="10000">%b</span>

[mode=do-not-disturb]
invisible=1
